# Source and derived databases are not source code.
# The master .db never enters this repository; neither does a published extract.
*.db
*.sqlite
*.sqlite3
!tests/fixtures/*.db

# Generated publish output (pages, search shards, sitemaps) is built, not committed.
/public/dog/
/public/s/
/public/sitemap*.xml

# Vitest rewrites its config to a timestamped file while running; this environment
# cannot delete, so the stubs are ignored rather than cleaned up.
vitest.config.ts.timestamp-*.mjs

# Private AI/dev guidance — kept at repo root so Claude Code auto-loads it locally,
# but never published. (If already tracked: git rm --cached CLAUDE.md)
CLAUDE.md
