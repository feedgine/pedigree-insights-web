# Deployment identifiers — the template. Copy to `deploy.local.env` and fill in.
#
#   cp deploy.env.example deploy.local.env
#   source deploy.local.env
#
# `deploy.local.env` is git-ignored. Everything in it is an IDENTIFIER, not a secret:
# reaching any of these still requires an authenticated Cloudflare account. Real
# credentials live where the tools that own them keep them, and are NOT copied here:
#
#   Cloudflare OAuth token   ~/Library/Preferences/.wrangler/config/default.toml
#   R2 S3 access key/secret  the `rclone` config (`rclone config file`)
#
# The reason to keep this file at all is that these values are otherwise scattered across
# a dashboard, three command outputs and a browser tab, and are needed months apart.

# --- Cloudflare account -------------------------------------------------------
CF_ACCOUNT_EMAIL=""
CF_ACCOUNT_ID=""

# --- Stores -------------------------------------------------------------------
R2_BUCKET="pedigree-payloads"
D1_NAME="pedigree"
D1_ID=""
# D1 pins a database to one region when it is created; it cannot be moved afterwards.
D1_REGION=""

# --- Pages --------------------------------------------------------------------
PAGES_PROJECT="pedigree-insights-web"
PAGES_DEV_URL=""
SITE_DOMAIN="pedigree.japanesespitz.org"

# --- R2 over the S3 API, for bulk upload with rclone --------------------------
R2_ENDPOINT=""
RCLONE_REMOTE="r2"

# --- Local paths --------------------------------------------------------------
# `~/Workspace` is the virtual workspace root. If that symlink is absent on this machine,
# set WORKSPACE to the absolute path instead.
WORKSPACE="${WORKSPACE:-$HOME/Workspace}"
MASTER_DB=""
# Holds every published URL. Back this up; losing it can move links (PRD R-5.2).
PUBLISH_STATE="publish-state/state.json"
PAYLOAD_DIR="out"
SITE_DIR="site"
